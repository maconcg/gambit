@i{setcar} : @t{E*} @arrow{} @t{P} @arrow{} @t{K} @arrow{} @t{C}
@end display

@display
@i{eqv} : @t{E*} @arrow{} @t{P} @arrow{} @t{K} @arrow{} @t{C}
@end display

@display
@i{apply} : @t{E*} @arrow{} @t{P} @arrow{} @t{K} @arrow{} @t{C}
