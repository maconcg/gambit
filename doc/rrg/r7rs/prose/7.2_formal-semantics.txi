@i{list} : @t{E*} @arrow{} @t{P} @arrow{} @t{K} @arrow{} @t{C}
@end display

@display
@i{cons} : @t{E*} @arrow{} @t{P} @arrow{} @t{K} @arrow{} @t{C}
@end display

@display
