@item @t{caaddr} @tab @t{caadr}
@item @t{cadaar} @tab @t{cadadr}
@item @t{cadar} @tab @t{caddar}
@item @t{cadddr} @tab @t{caddr}
@item @t{cdaaar} @tab @t{cdaadr}
@item @t{cdaar} @tab @t{cdadar}
