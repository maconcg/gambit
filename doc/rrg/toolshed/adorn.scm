(define (special-strings symbol)
  (define string-lists
    '((directive ("#!fold-case" "#!no-fold-case"))
      (false ("#false"))
      (fvector ("#f32(" "#f64("))
      (lambda ("lambda" "\x3bb;"))
      (long-quote ("quote"))
      (mv-define ("define-values"))
      (mv-let ("let-values" "let*-values"))
      (named-let ("let"))
      (sharp ("#!eof" "#!key" "#!optional" "#!rest" "#!void"))
      (short-named-char ("#\\esc" "#\\nul"))
      (short-quote ("'"))
      (sv-define ("define"))
      (sv-let ("let" "let*" "letrec" "letrec*" "parameterize"))
      (svector ("#s8(" "#s16(" "#s32(" "#s64("))
      (true ("#true"))
      (uvector ("#u8(" "#u16(" "#u32(" "#u64("))
      (long-named-char
       ("#\\null" "#\\alarm" "#\\backspace" "#\\tab" "#\\space" "#\\newline"
        "#\\return" "#\\delete" "#\\escape" "#\\page" "#\\vtab" "#\\linefeed"))
      (runtime-syntax
       ("and" "begin" "c-declare" "c-define" "c-define-type" "c-initialize"
        "c-lambda" "case" "case-lambda" "cond" "cond-expand" "declare" "define"
        "define-library" "define-macro" "define-record-type" "define-structure"
        "define-syntax" "define-type" "define-type-of-thread" "define-values"
        "delay" "delay-force" "do" "else" "future" "guard" "if" "import"
        "include" "include-ci" "\x3bb;" "lambda" "let" "let*" "let*-values"
        "let-values" "letrec" "letrec*" "letrec*-values" "letrec-values"
        "namespace" "or" "parameterize" "quasiquote" "quote" "r7rs-guard"
        "receive" "set!" "syntax-error" "syntax-rules" "this-source-file"
        "unless" "when"))))
  (cadr (assq symbol string-lists)))

(define (get-matching-kind+ep? spec)
  (case spec
    (( false true sharp fvector svector uvector )
     (values 'default octo-start?))
    (( lambda sv-define sv-let named-let mv-define mv-let )
     (values 'runtime-syntax #f))
    (( datumc-directive )
     (values 'datumc (lambda (ac) (eq? (get-mesg ac) 'datumc#))))
    (else (values #f #f))))

(define (looking-at spec ac-list #!key kind ep?)
  (define (truncate-acl trunc-predicate? ac-list)
    (if (null? ac-list)
        ac-list
        (if (trunc-predicate? (car ac-list))
            (truncate-acl trunc-predicate? (cdr ac-list))
            ac-list)))
  (define (looking-at-char-list char-list ac-list #!key k ep?)
    (let loop ((cl-rest char-list) (ac-rest ac-list))
      (if (null? cl-rest)
          ac-rest
          (and (not (null? ac-rest))
               (let ((next-char (car cl-rest))
                     (next-ac (car ac-rest)))
                 (and (or (not k) (eq? k (get-kind next-ac)))
                      (char=? next-char (get-char next-ac))
                      (let ((cdr-cl-rest (cdr cl-rest)))
                        (if (and ep? (null? cdr-cl-rest))
                            (and (ep? next-ac) ac-rest)
                            (loop cdr-cl-rest (cdr ac-rest))))))))))
  (define (looking-at-one-of list-of-char-lists ac-list #!key k ep?)
    (and (not (null? list-of-char-lists))
         (or (looking-at-char-list (car list-of-char-lists)
                                   ac-list k: k ep?: ep?)
             (looking-at-one-of (cdr list-of-char-lists)
                                ac-list k: k ep?: ep?))))
  (if (symbol? spec)
      (let-values (((k ep?) (get-matching-kind+ep? spec)))
        (case spec
          (( sv-define sv-let named-let mv-let mv-define lambda )
           (looking-at-one-of (get-char-lists spec)
                              (truncate-acl (lambda (ac)
                                              (atmosphere? ac))
                                            ac-list) k: k ep?: ep?))
          (( datumc )
           (looking-at-char-list
            '(#\; #\#)
            (truncate-acl (lambda (ac)
                            (let ((kind (get-kind ac)))
                              (or (memq kind '(linec nestc datumc-directive))
                                  (and (eq? kind 'datumc)
                                       (memc (get-char ac) '(#\space
                                                             #\newline
                                                             #\tab))))))
                          ac-list)
            k: 'datumc ep?: octo-start?))
          (( directive )
           (looking-at-one-of (get-char-lists spec)
                              (truncate-acl
                               (lambda (ac)
                                 (memq (get-kind ac)
                                       '(whitespace datumc linec nestc))))
                              k: k ep?: ep?))
          (( false true )
           (looking-at-one-of (get-char-lists spec) ac-list k: k ep?: ep?))
          (( keyword )
           (let ((ac (car ac-list)))
             (and (char=? (get-char ac) #\:)
                  (eq? (get-kind ac) 'default)
                  (not (get-mesg ac))
                  (not (null? (cdr ac-list)))
                  (let ((prev (cadr ac-list)))
                    (let ((prev-char (get-char prev))
                          (prev-kind (get-kind prev))
                          (prev-mesg (get-mesg prev)))
                      (or (and (eq? prev-kind 'identifier)
                               (char=? prev-char #\|)
                               (number? prev-mesg)
                               (number? (get-peer prev)))
                          (and (eq? prev-kind 'default)
                               (not (delimiter? prev-char))
                               (or (not prev-mesg)
                                   (eq? prev-mesg 'runtime-syntax)))))))))
          (( quote )
           (let ((truncated-acl (truncate-acl (lambda (ac)
                                                (atmosphere? ac))
                                              ac-list)))
             (or (looking-at-one-of (get-char-lists 'short-quote) truncated-acl
                                    k: 'abbrev)
                 (looking-at-one-of (get-char-lists 'long-quote) truncated-acl
                                    k: 'runtime-syntax))))
          (( runtime-syntax )
           (let ((acl (looking-at-one-of (get-char-lists 'runtime-syntax)
                                         ac-list
                                         k: k ep?: ep?)))
             (and acl (operator-position? acl))))
          (else
           (looking-at-one-of (get-char-lists spec) ac-list k: k ep?: ep?))))
      (looking-at-char-list spec ac-list k: kind ep?: ep?)))


(define (char-list-backmatch? goal actual)
  (let backmatch-loop ((goal (reverse goal)) (actual (reverse actual)))
    (or (null? goal)
        (and (not (null? actual))
             (char=? (car goal) (car actual))
             (backmatch-loop (cdr goal) (cdr actual))))))

(define (backmatch? goal actual)
  (let ((cl-goal (if (string? goal) (string->list goal) goal))
        (cl-actual (if (string? actual) (string->list actual) actual)))
    (char-list-backmatch? cl-goal cl-actual)))

(define (backmatch-one-of? goals actual)
  (and (not (null? goals))
       (or (backmatch? (car goals) actual)
           (backmatch-one-of? (cdr goals) actual))))

(define (char-list-could-match? goal actual)
  (or (null? actual)
      (and (not (null? goal))
           (char=? (car goal) (car actual))
           (char-list-could-match? (cdr goal) (cdr actual)))))

(define (could-match? goal actual)
  (let ((cl-goal (if (string? goal) (string->list goal) goal))
        (cl-actual (if (string? actual) (string->list actual) actual)))
    (char-list-could-match? cl-goal cl-actual)))

(define (could-match-one-of? goals actual)
  (and (not (null? goals))
       (or (could-match? (car goals) actual)
           (could-match-one-of? (cdr goals) actual))))

(define (distance-until ac-list char/mesg)
  (cond ((char? char/mesg)
         (let loop ((rest ac-list) (i 0))
           (cond ((null? rest) (error "Not found" char/mesg))
                 ((char=? (get-char (car rest)) char/mesg) i)
                 (else (loop (cdr rest) (+ i 1))))))
        ((symbol? char/mesg)
         (let loop ((rest ac-list) (i 0))
           (cond ((null? rest) (error "Not found" char/int/mesg/predicate?))
                 ((eq? (get-mesg (car rest)) char/mesg) i)
                 (else (loop (cdr rest) (+ i 1))))))))

(define (chars-until ac-list char/int/mesg/predicate?)
  (cond ((char? char/int/mesg/predicate?)
         (let loop ((chars '()) (rest ac-list))
           (if (null? rest)
               chars
               (let ((char (get-char (car rest))))
                 (if (char=? char char/int/mesg/predicate?)
                     (cons char chars)
                     (loop (cons char chars) (cdr rest)))))))
        ((integer? char/int/mesg/predicate?)
         (let loop ((chars '()) (rest ac-list) (i char/int/mesg/predicate?))
           (if (or (zero? i) (null? rest))
               chars
               (loop (cons (get-char (car rest)) chars) (cdr rest) (- i 1)))))
        ((symbol? char/int/mesg/predicate?)
         (let loop ((chars '()) (rest ac-list))
           (if (null? rest)
               chars
               (let ((ac (car rest)))
                 (let ((char (get-char ac))
                       (mesg (get-mesg ac)))
                   (if (eq? mesg char/int/mesg/predicate?)
                       (cons char chars)
                       (loop (cons char chars) (cdr rest))))))))
        (else (let loop ((chars '()) (rest ac-list))
                (if (null? rest)
                    chars
                    (let ((ac (car rest)))
                      (if (char/int/mesg/predicate? ac)
                          (cons (get-char ac) rest)
                          (loop (cons (get-char ac) chars) (cdr rest)))))))))

(define (revise-until! ac-list new-kind int/mesg/predicate? #!optional end-act)
  (cond ((integer? int/mesg/predicate?)
         (let loop ((rest ac-list) (i int/mesg/predicate?))
           (unless (or (null? rest) (> 1 i))
             (let ((ac (car rest)))
               (set-kind! ac new-kind)
               (when (and end-act (= i 1)) (end-act ac))
               (loop (cdr rest) (- i 1))))))
        ((symbol? int/mesg/predicate?)
         (let loop ((rest ac-list))
           (unless (null? rest)
             (let ((ac (car rest)))
               (set-kind! ac new-kind)
               (if (eq? (get-mesg ac) int/mesg/predicate?)
                   (when end-act (end-act ac))
                   (loop (cdr rest)))))))
        (else (let loop ((rest ac-list))
                (unless (null? rest)
                  (let ((ac (car rest)))
                    (if (int/mesg/predicate? ac)
                        (begin (set-kind! ac new-kind)
                               (when end-act (end-act ac)))
                        (loop (cdr rest)))))))))

(define (maybe-match? c acl strings until-mesg)
  (could-match-one-of? strings (append (chars-until acl until-mesg) (list c))))

(define (does-match? c acl strings until-mesg)
  (backmatch-one-of? strings (append (chars-until acl until-mesg) (list c))))

(define directives '("#!fold-case" "#!no-fold-case"))
(define (is-directive? c acl) (does-match? c acl directives 'octothorpe))
(define (maybe-directive? c acl) (maybe-match? c acl directives 'octothorpe))

(define sharps '("#!eof" "#!key" "#!optional" "#!rest" "#!void"))
(define (is-sharp? c acl) (does-match? c acl sharps 'octothorpe))
(define (maybe-sharp? c acl) (maybe-match? c acl sharps 'octothorpe))

(define fvectors '("#f32(" "#f64("))
(define uvectors '("#u8(" "#u16(" "#u32(" "#u64("))
(define svectors '("#s8(" "#s16(" "#s32(" "#s64("))
(define (maybe-fvector? c acl) (maybe-match? c acl fvectors 'octothorpe))
(define (maybe-svector? c acl) (maybe-match? c acl svectors 'octothorpe))
(define (maybe-uvector? c acl) (maybe-match? c acl uvectors 'octothorpe))
(define (is-fvector? c acl) (does-match? c acl fvectors 'octothorpe))
(define (is-svector? c acl) (does-match? c acl svectors 'octothorpe))
(define (is-uvector? c acl) (does-match? c acl uvectors 'octothorpe))

(define (is-false? c acl) (does-match? c acl '("#false") 'octothorpe))
(define (maybe-false? c acl) (maybe-match? c acl '("#false") 'octothorpe))
(define (is-true? c acl) (does-match? c acl '("#true") 'octothorpe))
(define (maybe-true? c acl) (maybe-match? c acl '("#true") 'octothorpe))

(define named-chars
  '("#\\null" "#\\alarm" "#\\backspace" "#\\tab" "#\\space" "#\\newline"
    "#\\return" "#\\delete" "#\\escape" "#\\page" "#\\vtab" "#\\linefeed"))
(define (maybe-named-char? c acl) (maybe-match? c acl named-chars 'octothorpe))
(define (is-named-char? c acl) (does-match? c acl named-chars 'octothorpe))

(define short-named-chars '("#\\esc" "#\\nul"))
(define (maybe-short-named-char? c acl)
  (maybe-match? c acl short-named-chars 'octothorpe))
(define (is-short-named-char? c acl)
  (does-match? c acl short-named-chars 'octothorpe))

(define (ac-find-by ac-list predicate?)
  (cond ((null? ac-list) '())
        ((predicate? (car ac-list)) ac-list)
        (else (ac-find-by (cdr ac-list) predicate?))))

(define (find-by-char ac-list char)
  (ac-find-by ac-list (lambda (ac) (char=? (get-char ac) char))))
(define (find-by-kind ac-list kind)
  (ac-find-by ac-list (lambda (ac) (eq? (get-kind ac) kind))))
(define (find-by-mesg ac-list mesg)
  (ac-find-by ac-list (lambda (ac) (eq? (get-mesg ac) mesg))))

(define (find-nearest-peer ac-list)
  (if (null? ac-list)
      '()
      (let ((ac (car ac-list)))
        (if (get-peer ac)
            ac
            (find-nearest-peer (cdr ac-list))))))

(define (ac-trim ac-list predicate?)
  (if (predicate? (car ac-list))
      (ac-trim (cdr ac-list) predicate?)
      ac-list))

