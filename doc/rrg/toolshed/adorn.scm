(define (unmatched-lparen? ac)
  (and (eq? (get-kind ac) 'list)
       (not (get-peer ac))
       (char=? (get-char ac) #\()))

(define (start-of-list ac-list #!optional (predicate? unmatched-lparen?))
  (cond ((null? ac-list) '())
        ((predicate? (car ac-list)) ac-list)
        (else (start-of-list (cdr ac-list) predicate?))))

(define (up-list ac-list #!optional (predicate? unmatched-lparen?))
  (if (null? ac-list)
      '()
      (start-of-list (cdr ac-list) predicate?)))

(define (start-of? token ac-list)
  (and (not (null? ac-list))
       (let ((ac (car ac-list)) (rest (cdr ac-list)))
         (and (symbol=? (get-kind ac) 'default)
              (case token
                (( lambda )
                 (let ((list-start (start-of-list ac-list)))
                   (and (not (null? list-start))
                        (let ((outside (cdr list-start)))
                          (and (not (operator-position? outside))
                               (looking-at 'lambda outside))))))
                (( define-proc )
                 (and (operator-position? rest)
                      (let ((cdr-signature (cdr (start-of-list ac-list))))
                        (and (not (operator-position? cdr-signature))
                             (looking-at 'sv-define cdr-signature)))))
                (( define-var )
                 (and (not (null? rest))
                      (not (operator-position? rest))
                      (looking-at 'sv-define rest)))
                (( named-let-var )
                 (and (not (null? rest))
                      (not (operator-position? rest))
                      (looking-at 'named-let rest)))
                (( sv-let-formal )
                 (and (operator-position? rest)
                      (let* ((inner (start-of-list ac-list))
                             (outer (up-list inner)))
                        (and (operator-position? inner)
                             (operator-position? outer)
                             (let ((outside (cdr outer)))
                               (and (not (operator-position? outside))
                                    (looking-at 'sv-let outside)))))))
                (( mv-define )
                 (let ((var-list (start-of-list ac-list)))
                   (and (operator-position? var-list)
                        (let ((outside (cdr var-list)))
                          (and (not (operator-position? outside))
                               (looking-at 'mv-define outside))))))
                (( mv-let-formal )
                 (let ((inner (start-of-list ac-list)))
                   (and (operator-position? inner)
                        (operator-position? (cdr inner))
                        (let ((mid (up-list inner)))
                          (and (operator-position? mid)
                               (let ((outer (up-list mid)))
                                 (and (operator-position? outer)
                                      (let ((outside (cdr outer)))
                                        (and (not (operator-position? outside))
                                             (looking-at 'mv-let
                                                          outside))))))))))
                (( named-let-formal )
                 (and (operator-position? rest)
                      (let* ((inner (start-of-list ac-list))
                             (outer (up-list inner)))
                        (and (operator-position? inner)
                             (operator-position? outer)
                             (let ((outside (cdr outer)))
                               (and (not (operator-position? outside))
                                    (let loop ((rest outside) (named? #f))
                                      (and (not (null? rest))
                                           (let ((kind (get-kind (car rest))))
                                             (cond ((atmosphere-kind? kind)
                                                    (loop (cdr rest) named?))
                                                   ((eq? kind 'bind)
                                                    (loop (cdr rest) #t))
                                                   (else (and named?
                                                              (looking-at
                                                               'named-let
                                                               rest)))))))))))))
                 (else (error "Unknown token")))))))
