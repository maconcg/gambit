(define-macro (%datumc-string backslash end)
  `(cond ((char=? nc #\") (box-ac! nc 'datumc ,end #f))
         ((char=? nc #\\) (box-ac! nc 'datumc ,backslash #f))
         (else (box-ac! nc 'datumc pm #f))))

(define-macro (%ident/string backslash delim fallback)
  `(cond ((char=? nc ,delim)
          (box-ac! nc ,fallback #f #f)
          (simple-peer! adorned (unbox ac-box) ,fallback))
         ((char=? nc #\\)
          (box-ac! nc ,fallback ,backslash #f))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%ident/string-backslash esc fallback hex-x hex-u hex-U nil oct)
  `(cond ((char=? nc #\x) (box-ac! nc ,fallback ,hex-x #f))
         ((char=? nc #\u) (box-ac! nc ,fallback ,hex-u #f))
         ((char=? nc #\u) (box-ac! nc ,fallback ,hex-U #f))
         ((char=? nc #\newline)
          (set-kind! (unbox ac-box) ,esc)
          (box-ac! nc ,fallback ,nil #f))
         ((octal-char? nc)
          (set-kind! (unbox ac-box) ,esc)
          (box-ac! nc ,esc ,oct #f))
         ((memc nc '(#\a #\b #\f #\n #\r #\t #\v #\" #\\ #\| #\? #\space))
          (set-kind! (unbox ac-box) ,esc)
          (box-ac! nc ,esc ,fallback #f))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%ident/string-hex-Uu backslash delim dist esc fallback hex-Uu)
  `(cond ((char=? nc ,delim)
          (box-ac! nc ,fallback #f #f)
          (simple-peer! adorned (unbox ac-box) ,fallback))
         ((hexadecimal-char? nc)
          (if (> ,dist (distance-until adorned ,backslash))
              (box-ac! nc ,fallback ,hex-Uu #f)
              (begin (box-ac! nc ,esc ,fallback #f)
                     (revise-until! adorned ,esc ,(+ dist 1)))))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%ident/string-hex-x backslash delim esc fallback hex-x)
  `(cond ((char=? nc ,delim)
          (box-ac! nc ,fallback #f #f)
          (simple-peer! adorned (unbox ac-box) ,fallback))
         ((char=? nc #\;)
          (box-ac! nc ,esc ,fallback #f)
          (revise-until! adorned ,esc ,backslash))
         ((hexadecimal-char? nc)
          (box-ac! nc ,fallback ,hex-x #f))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%ident/string-nil backslash delim esc fallback esc-nil)
  `(cond ((char=? nc ,delim)
          (box-ac! nc ,fallback #f #f)
          (simple-peer! adorned (unbox ac-box) ,fallback))
         ((char=? nc #\\)
          (box-ac! nc ,fallback ,backslash #f))
         ((memc nc '(#\space #\tab))
          (box-ac! nc ,fallback ,esc-nil #f))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%ident/string-octal-second backslash delim esc fallback third)
  `(cond ((char=? nc ,delim)
          (box-ac! nc ,fallback #f #f)
          (simple-peer! adorned (unbox ac-box) ,fallback))
         ((char=? nc #\\)
          (box-ac! nc ,fallback ,backslash #f))
         ((octal-char? nc)
          (if (memc (get-char (unbox ac-box)) '(#\0 #\1 #\2 #\3))
              (box-ac! nc ,esc ,third #f)
              (box-ac! nc ,esc ,fallback #f)))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%ident/string-octal-third backslash delim esc fallback)
  `(cond ((char=? nc ,delim)
          (box-ac! nc ,fallback #f #f)
          (simple-peer! adorned (unbox ac-box) ,fallback))
         ((char=? nc #\\)
          (box-ac! nc ,fallback ,backslash #f))
         ((octal-char? nc)
          (box-ac! nc ,esc ,fallback #f))
         (else (box-ac! nc ,fallback ,fallback #f))))

(define-macro (%~hvector/directive/sharp/boolean
               ~mesg mesg kind fallback octo-mesg peer invalid-proc strings)
  `(cond ((does-match? nc adorned ,strings ,octo-mesg)
          (box-ac! nc ,kind ,mesg ,peer)
          (revise-until! adorned ,kind ,octo-mesg))
         ((maybe-match? nc adorned ,strings ,octo-mesg)
          (box-ac! nc ,fallback ,~mesg #f))
         ((not (delimiter? nc)) (,invalid-proc nc))))

(define-macro (%begin-datumc-compound)
  '(if (in-datumc-compound? adorned)
       (let ((sub-compound (compound-begin adorned nc 'datumc-compound)))
         (set-box! ac-box sub-compound))
       (let ((top-compound (compound-begin adorned nc 'datumc-top-compound)))
         (set-kind! top-compound 'datumc-compound)
         (set-box! ac-box top-compound))))

(define (datumc-compound-b+c+d ac-list)
  (let seek-beginning ((rest ac-list) (distance 1))
    (if (null? rest)
        (error "Unable to find beginning of datumc compound")
        (let ((mesg (get-mesg (car rest))))
          (cond ((eq? mesg 'datumc-compound-unmatched)
                 (values rest 'sub-compound distance))
                ((eq? mesg 'datumc-top-compound-unmatched)
                 (values rest 'top-compound distance))
                (else (seek-beginning (cdr rest) (+ distance 1))))))))

(define-macro (%end-datumc-compound)
  '(let-values (((start class distance) (datumc-compound-b+c+d adorned)))
     (if (eq? class 'top-compound)
         (let ((peer (car start)))
           (set-mesg! peer 'datumc-top-compound-begin)
           (set-peer! peer distance)
           (set-stack! peer '())
           (let-values (((peer extra-dist) (peer+distance start #\# 'datumc)))
             (let ((peer-stack (get-stack peer))
                   (total-distance (+ distance extra-dist)))
               (set-peer! peer total-distance)
               (set-stack! peer (cdr peer-stack))
               (box-ac! nc 'datumc (and (> (length peer-stack) 1)
                                        'datumc-top-compound-end)
                        (- total-distance)))))
         (set-box! ac-box (compound-end adorned nc 'datumc-compound)))))

(define-macro (%maybe-end-datumc)
  '(let-values (((peer distance) (peer+distance adorned #\# 'datumc)))
     (unless (null? peer)
       (let ((stack (get-stack peer))
             (prev-ac (unbox ac-box)))
         (let* ((top-peer (caar stack))
                (total-distance (+ distance (get-peer top-peer))))
           (if (in-datumc-compound? adorned)
               (%~datumc 'datumc-compound)
               (if (char=? nc #\))
                   (box-ac! nc 'invalid '~datumc #f '())
                   (begin (set-peer! prev-ac (- total-distance))
                          (set-peer! top-peer total-distance)
                          (set-stack! peer '())
                          (if (> (length stack) 1)
                              (box-ac! nc 'datumc '~datumc #f '())
                              (begin (set-mesg! prev-ac 'datumc-end)
                                     (set-stack! prev-ac '())))))))))))

(define-macro (%~datumc symbol)
  `(cond ((char=? nc #\() (%begin-datumc-compound))
         ((char=? nc #\#) (box-ac! nc 'datumc 'datumc# #f))
         ((char=? nc #\") (box-ac! nc 'datumc 'datumc-string #f))
         ((char=? nc #\;) (box-ac! nc 'linec 'linec #f))
         ((char=? nc #\)) (%end-datumc-compound))
         ((or (memc nc '(#\space #\newline #\tab #\' #\` #\,))
              (and (char=? nc #\@) (memc pc '(#\' #\` #\,))))
          (box-ac! nc 'datumc ,symbol #f))
         (else (box-ac! nc 'datumc 'datumc-simple #f))))

(define directives '("#!fold-case" "#!no-fold-case"))
(define sharps '("#!eof" "#!key" "#!optional" "#!rest" "#!void"))
(define fvector-strings '("#f32(" "#f64("))
(define svector-strings '("#s8(" "#s16(" "#s32(" "#s64("))
(define uvector-strings '("#u8(" "#u16(" "#u32(" "#u64("))

(define (adorn! chars #!optional (so-far '()))
  (define ac-box (box (if (null? so-far)
                          (adorn-char #f #f #f #f '())
                          (car so-far))))
  (define (box-ac! char kind mesg peer? #!optional (peer-stack '()))
    (set-box! ac-box (adorn-char char kind mesg peer? peer-stack)))
  (define (no-context-values char)
    (lambda ()
      (case char
        (( #\\ ) (values char 'infix #f #f))
        (( #\; ) (values char 'linec 'linec #f))
        (( #\# ) (values char 'default 'octothorpe #f))
        (( #\| ) (values char 'ident 'ident-begin #f))
        (( #\" ) (values char 'string 'string-begin #f))
        (( #\' ) (values char 'quote #f #f))
        (( #\` ) (values char 'quasiquote #f #f))
        (( #\, ) (values char 'unquote #f #f))
        (( #\space #\newline #\tab ) (values char 'whitespace #f #f))
        (else (values char 'default #f #f)))))
  (define (box-no-context! char)
    (call-with-values (no-context-values char) box-ac!))
  (define (refresh-ac! ac)
    (call-with-values (no-context-values (get-char ac))
      (lambda (char kind mesg peer)
        (set-kind! ac kind)
        (set-mesg! ac mesg)
        (set-peer! ac #f))))
  (define (box-invalid! char)
    (box-ac! char 'invalid 'invalid #f '()))
  (let loop ((adorned so-far)
             (unadorned (if (string? chars) (string->list chars) chars))
             (index (length so-far)))
    (if (null? unadorned)
        adorned
        (let ((nc (car unadorned))
              (pm (get-mesg (unbox ac-box))))
          (case pm
            (( ~fvector )
             (%~hvector/directive/sharp/boolean
              '~fvector 'fvector 'fvector 'default 'octothorpe index
              box-invalid! fvector-strings))
            (( ~svector )
             (%~hvector/directive/sharp/boolean
              '~svector 'svector 'svector 'default 'octothorpe index
              box-invalid! svector-strings))
            (( ~uvector )
             (%~hvector/directive/sharp/boolean
              '~uvector 'uvector 'uvector 'default 'octothorpe index
              box-invalid! uvector-strings))
            (( ~directive )
             (%~hvector/directive/sharp/boolean
              '~directive 'directive 'directive 'default 'octothorpe #f
              box-invalid! directives))
            (( ~false )
             (%~hvector/directive/sharp/boolean
              '~false 'false 'false 'default 'octothorpe #f box-invalid!
              '("#false")))
            (( ~sharp )
             (%~hvector/directive/sharp/boolean
              '~sharp 'sharp 'sharp 'default 'octothorpe #f box-invalid!
              sharps))
            (( ~true )
             (%~hvector/directive/sharp/boolean
              '~true 'true 'true 'default 'octothorpe #f box-invalid!
              '("#true")))
            (( string string-begin )
             (%ident/string 'string-backslash #\" 'string))
            (( ident ident-begin )
             (%ident/string 'ident-backslash #\| 'ident))
            (( string-backslash )
             (%ident/string-backslash 'string-escape 'string 'string-hex-x
                                      'string-hex-u 'string-hex-U
                                      'string-escape-nil 'string-octal-second))
            (( ident-backslash )
             (%ident/string-backslash 'ident-escape 'ident 'ident-hex-x
                                      'ident-hex-u 'ident-hex-U
                                      'ident-escape-nil 'ident-octal-second))
            (( string-hex-u )
             (%ident/string-hex-Uu 'string-backslash #\" 4 'string-escape
                                   'string 'string-hex-u))
            (( ident-hex-u )
             (%ident/string-hex-Uu 'ident-backslash #\| 4 'ident-escape
                                   'ident 'ident-hex-u))
            (( string-hex-U )
             (%ident/string-hex-Uu 'string-backslash #\" 8 'string-escape
                                   'string 'string-hex-U))
            (( ident-hex-U )
             (%ident/ident-hex-Uu 'ident-backslash #\| 8 'ident-escape
                                  'ident 'ident-hex-U))
            (( string-hex-x )
             (%ident/string-hex-x 'string-backslash #\" 'string-escape
                                  'string 'string-hex-x))
            (( ident-hex-x )
             (%ident/string-hex-x 'ident-backslash #\| 'ident-escape
                                  'ident 'ident-hex-x))
            (( string-nil )
             (%ident/string-nil 'string-backslash #\" 'string-escape 'string
                                'string-nil))
            (( ident-nil )
             (%ident/string-nil 'ident-backslash #\| 'ident-escape 'ident
                                'ident-nil))
            (( string-octal-second )
             (%ident/string-octal-second 'string-backslash #\" 'string-escape
                                         'string 'string-octal-third))
            (( ident-octal-second )
             (%ident/string-octal-second 'ident-backslash #\| 'ident-escape
                                         'ident 'ident-octal-third))
            (( string-octal-third )
             (%ident/string-octal-third 'string-backslash #\" 'string-esc
                                        'string))
            (( ident-octal-third )
             (%ident/string-octal-third 'ident-backslash #\| 'ident-esc
                                        'ident))
            (( ~char-first )
             (cond ((maybe-named-char? nc adorned)
                    (box-ac! nc 'char-body '~char-second #f))
                   (else (box-ac! nc 'char-body 'char #f)
                         (revise-until! adorned 'default 'octothorpe))))
            (( ~char-second )
             (when (maybe-named-char? nc adorned)
               (box-ac! nc 'default '~char-third #f))
             (revise-until! adorned 'default 'octothorpe))
            (( ~char-third )
             (cond ((is-short-named-char? nc adorned)
                    (box-ac! nc 'char-body 'short-named-char #f)
                    (revise-until! adorned 'char 'octothorpe)
                    (revise-until! adorned 'char-body '~char-second))
                   ((maybe-named-char? nc adorned)
                    (box-ac! nc 'default '~named-char #f))
                   ((not (delimiter? nc))
                    (box-invalid! nc))))
            (( ~named-char )
             (cond ((is-named-char? nc adorned)
                    (box-ac! nc 'char-body 'char #f)
                    (revise-until! adorned 'char 'octothorpe)
                    (revise-until! adorned 'char-body '~char-second))
                   ((maybe-named-char? nc adorned)
                    (box-ac! nc 'default '~named-char #f))
                   ((not (delimiter? nc))
                    (box-invalid! nc))))
            (( short-named-char )
             (cond ((is-named-char? nc adorned)
                    (box-ac! nc 'char-body 'char #f))
                   ((maybe-named-char? nc adorned)
                    (box-ac! nc 'default '~named-char #f)
                    (revise-until! adorned 'default 'octothorpe))
                   ((not (delimiter? nc))
                    (box-invalid! nc))))
            (( ~directive/sharp )
             (cond ((memc nc '(#\f #\n))
                    (box-ac! nc 'default '~directive #f))
                   ((memc nc '(#\e #\k #\o #\r #\v))
                    (box-ac! nc 'default '~sharp #f))
                   ((not (delimiter? nc))
                    (box-invalid! nc))))
            (( ~false/fvector )
             (cond ((char=? nc #\a)
                    (box-ac! nc 'default '~false #f)
                    (revise-until! adorned 'default 'octothorpe))
                   ((memc nc '(#\3 #\6))
                    (box-ac! nc 'default '~fvector #f)
                    (revise-until! adorned 'default 'octothorpe))
                   ((not (delimiter? nc))
                    (box-invalid! nc))))
        (( ~datumc )
         (%~datumc '~datumc))
        (( datumc-top-compound-end )
         (%~datumc '~datumc))
        (( datumc-compound-unmatched datumc-top-compound-unmatched
           datumc-compound )
         (%~datumc 'datumc-compound))
        (( datumc-compound-end )
         (%~datumc 'datumc-compound))
        (( datumc-simple datumc-string-end )
         (cond ((delimiter? nc) (%maybe-end-datumc))
               (else (box-ac! nc 'datumc 'datumc-simple #f))))
        (( datumc# )
         (cond ((char=? nc #\!) (box-ac! nc 'datumc '~datumc-directive #f))
               ((char=? nc #\f) (box-ac! nc 'datumc '~datumc-fvector #f))
               ((char=? nc #\s) (box-ac! nc 'datumc '~datumc-svector #f))
               ((char=? nc #\u) (box-ac! nc 'datumc '~datumc-uvector #f))
               ((char=? nc #\\) (box-ac! nc 'datumc '~datumc-simple  #f))
               ((char=? nc #\() (%begin-datumc-compound))
               ((char=? nc #\;)
                (let-values (((peer dist) (peer+distance adorned #\# 'datumc)))
                  (let ((peer-stack (get-stack peer))
                        (previous-ac (unbox ac-box)))
                    (increment-peer-stack! peer-stack dist)
                    (set-peer! previous-ac 0)
                    (set-stack! peer '())
                    (let ((new-stack (cons (list previous-ac) peer-stack)))
                      (set-stack! previous-ac new-stack))
                    (box-ac! nc 'datumc '~datumc #f '()))))
               ((delimiter? nc) (%maybe-end-datumc))
               (else (box-ac! nc 'datumc 'datumc-simple))))
        (( ~datumc-fvector )
         (%~hvector/directive/sharp/boolean
          '~datumc-fvector 'datumc-compound-begin 'datumc 'datumc 'datumc#
          index (lambda (c) (box-ac! c 'datumc 'datumc-simple #f))
          fvector-strings)
         (when (eq? (get-mesg (unbox ac-box)) 'datumc-compound-begin)
                    (%begin-datumc-compound)))
        (( ~datumc-svector )
         (%~hvector/directive/sharp/boolean
          '~datumc-svector 'datumc-compound-begin 'datumc 'datumc 'datumc#
          index (lambda (c) (box-ac! c 'datumc 'datumc-simple #f))
          svector-strings)
         (when (eq? (get-mesg (unbox ac-box)) 'datumc-compound-begin)
                    (%begin-datumc-compound)))
        (( ~datumc-uvector )
         (%~hvector/directive/sharp/boolean
          '~datumc-uvector 'datumc-compound-begin 'datumc 'datumc 'datumc#
          index (lambda (c) (box-ac! c 'datumc 'datumc-simple #f))
          uvector-strings)
         (when (eq? (get-mesg (unbox ac-box)) 'datumc-compound-begin)
                    (%begin-datumc-compound)))
        (( datumc-string )
         (%datumc-string 'datumc-string-backslash 'datumc-string-end))
        (( datumc-compound-string )
         (%datumc-string 'datumc-compound-string-backslash
                         'datumc-compound-string-end))
        (( datumc-string-backslash )
         (box-ac! nc 'datumc 'datumc-string #f))
        (( datumc-compound-string-backslash )
         (box-ac! nc 'datumc 'datumc-compound-string #f))
        (( datumc-compound-string-end )
         (box-ac! nc 'datumc 'datumc-compound #f))
        ;; (( datumc-compound datumc-compound-begin )
        ;;  (if (char=? nc #\))
        ;;      (let-values (((list-start ldist) (start-of-list adorned)))
