(define-record-type achar
  (adorn-char c k m p s)
  adorned-char?
  (c get-char)
  (k get-kind set-kind!)
  (m get-mesg set-mesg!)
  (p get-peer set-peer!)
  (s get-stack set-stack!))
;==============================================================================
(define (memc c l) (member c l char=?))
(define (octal-char? c) (memc c '(#\0 #\1 #\2 #\3 #\4 #\5 #\6 #\7)))
(define (decimal-char? c) (or (octal-char? c) (memc c '(#\8 #\9))))
(define (hexadecimal-char? c) (or (decimal-char? c)
                                  (memc c '(#\a #\b #\c #\d #\e #\f
                                            #\A #\B #\C #\D #\E #\F))))
(define (whitespace-char? c) (memc c '(#\space #\newline #\tab)))
(define (delimiter? c)
  (memc c '( #\) #\( #\space #\newline #\tab #\" #\; #\| #\\ )))

(define (atmosphere-kind? kind)
  (memq kind '(whitespace linec datumc nestc directive)))

(define (atmosphere? ac) (atmosphere-kind? (get-kind ac)))

(define set-kind+mesg!
  (case-lambda
    ((ac km) (set-kind! ac km) (set-mesg! ac km))
    ((ac k m) (set-kind! ac k) (set-mesg! ac m))))

(define (revise! ac-list old-kind new-kind #!optional (ep? not))
  (unless (null? ac-list)
    (let ((ac (car ac-list)))
      (when (eq? (get-kind ac) old-kind)
        (set-kind! ac new-kind)
        (unless (ep? ac)
          (revise! (cdr ac-list) old-kind new-kind ep?))))))

(define (start-of-kind ac-list k)
  (cond ((null? ac-list) '())
        ((eq? (get-kind (car ac-list)) k) (start-of-kind (cdr ac-list) k))
        (else ac-list)))

(define (char-second? ac) (eq? (get-mesg ac) '~char-second))
;; (define (octo-start? ac) (eq? (get-mesg ac) 'octothorpe))
;==============================================================================
(define (get+set-nested-comment-info! symbol ac-list)
  (define (get-nested-comment-info)
    (let loop ((rest (cdr ac-list)))
      (unless (null? rest)
        (if (memq (get-mesg (car rest)) '(nestc- nestc+ nestc-begin))
            (let ((previous-cache-ac (cadr rest))
                  (operator (if (symbol=? symbol 'nestc-) - +)))
              (values (operator (get-mesg previous-cache-ac) 1)
                      (get-peer previous-cache-ac)))
            (loop (cdr rest))))))
  (call-with-values get-nested-comment-info
    (lambda (nesting peer)
      (let ((cache-ac (cadr ac-list)))
        (set-mesg! cache-ac nesting) (set-peer! cache-ac peer) nesting))))

(define (get-hs-key ac-list)
  (let loop ((key '()) (rest ac-list))
    (if (null? rest)
        '()
        (let* ((ac (car rest))
               (kind (get-kind ac)))
          (cond ((eq? kind 'hs-key) (loop (cons (get-char ac) key) (cdr rest)))
                ((eq? kind 'hs-begin) key)
                (else (loop key (cdr rest))))))))

(define (trim-ac-list ac-list predicate?)
  (if (predicate? (car ac-list))
      (trim-ac-list (cdr ac-list) predicate?)
      ac-list))

(define (from-previous-datumc ac-list)
  (define (should-trim? ac)
    (let ((kind (get-kind ac)))
      (or (memq kind '(linec nestc datumc-directive))
          (and (eq? kind 'datumc) (whitespace-char? (get-char ac))))))
  (let ((trimmed-ac-list (trim-ac-list ac-list should-trim?)))
    (and (backmatch? "#;" (chars-until trimmed-ac-list 2)) trimmed-ac-list)))

(define (unused-datum-comment? ac-list)
  (and ac-list (not (null? ac-list))
       (let ((ac (car ac-list)))
         (or (and (number? (get-peer ac)) (eq? (get-mesg ac) '~datumc))
             (and (memq (get-kind ac) '(datumc linec nestc))
                  (unused-datum-comment? (cdr ac-list)))))))
;==============================================================================
(define (append-to-symbol string)
  (lambda (symbol)
    (string->symbol (string-append (symbol->string symbol) string))))
(define (append-begin symbol) ((append-to-symbol "-begin") symbol))
(define (append-end symbol) ((append-to-symbol "-end") symbol))
(define (append-unmatched symbol) ((append-to-symbol "-unmatched") symbol))

(define (prepend-to-symbol string)
  (lambda (symbol)
    (string->symbol (string-append string (symbol->string symbol)))))
(define (prepend-empty symbol) ((prepend-to-symbol "empty-") symbol))
(define (prepend-matched symbol) ((prepend-to-symbol "matched-") symbol))

(define (simple-peer! ac-list ending-ac ending-kind)
  (define (get-nearest-peer+distance ending-kind)
    (lambda ()
      (let ((beginning-mesg (append-begin ending-kind)))
        (let seek-peer ((rest ac-list) (distance 1))
          (if (null? rest)
              (error "Unable to find a peer")
              (let* ((ac (car rest))
                     (ac-mesg (get-mesg ac)))
                (if (and (eq? ac-mesg beginning-mesg) (not (get-peer ac)))
                    (values ac distance)
                    (seek-peer (cdr rest) (+ distance 1)))))))))
  (define (match-peers! beginning-ac distance)
    (set-peer! beginning-ac distance)
    (set-peer! ending-ac (- distance)))
  (call-with-values (get-nearest-peer+distance ending-kind) match-peers!))

(define compound-kinds '(list vector fvector svector uvector datumc-compound))

(define compound-begins (map append-begin compound-kinds))
(define compound-ends (map append-end compound-kinds))
(define compound-unmatched (map append-unmatched compound-kinds))
(define compound-delimiters (append compound-unmatched compound-ends))

(define (compound-begin-mesg? ac) (memq (get-mesg ac) compound-begins))
(define (compound-end-mesg? ac) (memq (get-mesg ac) compound-ends))
(define (compound-delimiter? ac) (memq (get-mesg ac) compound-delimiters))

(define (get-peer-ac+distance predicate?)
  (lambda (ac-list)
    (let seek ((rest ac-list) (distance 0))
      (if (null? rest)
          (values '() 0)
          (let ((ac (car rest)))
            (if (and (not (null? (get-stack ac))) (predicate? ac))
                (values ac distance)
                (seek (cdr rest) (+ distance 1))))))))

(define (get-peer-ac+distance+empty? predicate?)
  (lambda (ac-list)
    (let ((empty? #t))
      (let seek ((rest ac-list) (distance 0))
        (if (null? rest)
            (values '() 0 #f)
            (let ((ac (car rest)))
              (if (and (not (null? (get-stack ac))) (predicate? ac))
                  (values ac distance empty?)
                  (begin (when empty? (set! empty? (atmosphere? ac)))
                         (seek (cdr rest) (+ distance 1))))))))))

(define (compatible-delimiter? char kind)
  (let ((compatible-chars (or (assoc char '(( #\( #\) ) ( #\) #\( )
                                            ( #\[ #\] ) ( #\] #\[ )
                                            ( #\{ #\} ) ( #\} #\{ )) char=?)
                              (list char)))
        (compatible-kinds (list kind (prepend-empty kind)))
        (compatible-mesgs (list (append-unmatched kind) (append-end kind))))
    (lambda (ac)
      (and (memc (get-char ac) compatible-chars)
           (memq (get-kind ac) compatible-kinds)
           (or (= 1 (length compatible-chars))
               (memq (get-mesg ac) compatible-mesgs))))))

(define (peer+distance+empty? ac-list #!optional (char #\() (kind 'list))
  ((get-peer-ac+distance+empty? (compatible-delimiter? char kind)) ac-list))

(define (peer+distance ac-list #!optional (char #\() (kind 'list))
  ((get-peer-ac+distance (compatible-delimiter? char kind)) ac-list))

(define (increment-peer-stack! ac-lists amount)
  (let ((heads (map car ac-lists)))
    (for-each (lambda (ac) (set-peer! ac (+ (get-peer ac) amount))) heads)))

(define (compound-begin ac-list #!optional (char #\() (kind 'list))
  (let-values (((peer dist) (peer+distance ac-list char kind)))
    (let ((unmatched-kind (append-unmatched kind)))
      (if (null? peer)
          (let ((new-ac (adorn-char char kind unmatched-kind 0 '())))
            (set-stack! new-ac (list (cons new-ac ac-list)))
            new-ac)
          (let ((peer-stack (get-stack peer)))
            (if (and (null? peer-stack) (not (char=? (get-char peer) char)))
                (let ((new-ac (adorn-char char kind unmatched-kind 0 '())))
                  (set-stack! new-ac (list (cons new-ac ac-list)))
                  new-ac)
                (let* ((new-ac (adorn-char char kind unmatched-kind 0 #f))
                       (new-stack (cons (cons new-ac ac-list) peer-stack)))
                  (increment-peer-stack! peer-stack (+ dist 1))
                  (set-stack! peer (cdr peer-stack))
                  (set-stack! new-ac new-stack)
                  new-ac)))))))

(define (compound-end ac-list #!optional (char #\)) (kind 'list))
  (let-values (((peer dist empty) (peer+distance+empty? ac-list char kind)))
    (if (null? peer)
        (adorn-char char 'unknown-unmatched #f #f '())
        (let ((peer-stack (get-stack peer)))
          (if (char=? (get-char peer) char)
              (if (null? peer-stack)
                  (adorn-char char 'unknown-unmatched #f #f '())
                  (let ((distance (+ dist 1))
                        (top-peer (caar peer-stack))
                        (rest (cdr peer-stack)))
                    (let ((peer-kind (get-kind top-peer))
                          (total-distance (+ distance (get-peer top-peer))))
                      (let ((mesg (append-end peer-kind))
                            (end-distance (- total-distance)))
                        (increment-peer-stack! peer-stack distance)
                        (set-mesg! top-peer (append-begin peer-kind))
                        (let ((stack (cdr (get-stack peer))))
                          (set-stack! peer '())
                          (set-stack! top-peer '())
                          (adorn-char char kind mesg end-distance stack))))))
              (let ((distance (+ dist 1))
                    (peer-kind (get-kind peer))
                    (stack (if (null? peer-stack) '() (cdr peer-stack))))
                (let ((mesg (append-end peer-kind))
                      (new-kind (cond ((memq kind '(datumc-compound
                                                    datumc-top-compound))
                                       peer-kind)
                                      (empty (prepend-empty peer-kind))
                                      (else peer-kind))))
                  (set-kind! peer new-kind)
                  (set-mesg! peer (append-begin peer-kind))
                  (increment-peer-stack! peer-stack distance)
                  (set-peer! peer distance)
                  (set-stack! peer '())
                  (adorn-char char new-kind mesg (- distance) stack))))))))

(define (in-datumc-compound? ac-list)
  (and (not (null? ac-list))
       (let* ((ac (car ac-list)) (mesg (get-mesg ac)))
         (and mesg (cond ((memq mesg '( datumc-compound datumc-compound-end
                                        datumc-compound-unmatched
                                        datumc-top-compound-unmatched)) #t)
                         ((memq mesg '( ~datumc datumc-top-compound-end
                                        octothorpe whitespace)) #f)
                         (else (in-datumc-compound? (cdr ac-list))))))))

(define (nested-comment-peer! ending-ac ac-list index)
  (unless (null? ac-list)
    (if (eq? (get-mesg (car ac-list)) 'nestc-begin)
        (let* ((ac (cadr ac-list)) (ac-index (get-peer ac)))
          (set-mesg! ac ac-index)
          (set-peer! ac index)
          (set-mesg! ending-ac index)
          (set-peer! ending-ac ac-index))
        (nested-comment-peer! ending-ac (cdr ac-list) index))))
;==============================================================================
(define (operator-position? ac-list)
  (and (not (null? ac-list))
       (let ((ac (car ac-list)))
         (if (atmosphere? ac)
             (operator-position? (cdr ac-list))
             (and (eq? (get-kind ac) 'list) (char=? (get-char ac) #\())))))

(define (quoted? ac-list)
  (define (case-key? ac-list)
    (let* ((inner (start-of-list ac-list)) (outer (up-list inner)))
      (and (operator-position? inner)
           (operator-position? (cdr inner))
           (operator-position? outer)
           (let ((outside (cdr outer)))
             (and (not (operator-position? outside))
                  (let loop ((rest outside) (buffer '()))
                    (and (not (null? rest))
                         (let* ((ac (car rest)) (kind (get-kind ac)))
                           (if (eq? kind 'runtime-syntax)
                               (loop (cdr rest) (cons (get-char ac) buffer))
                               (if (and (eq? kind 'list)
                                        (char=? (get-char ac) #\()
                                        (not (get-peer ac)))
                                   (string=? (list->string buffer) "case")
                                   (loop (cdr rest) '())))))))))))
  (and (not (null? ac-list))
       (or (looking-at 'quote ac-list)
           (case-key? ac-list)
           (let ((enclosing-list (up-list ac-list)))
             (and (not (null? enclosing-list))
                  (quoted? (cdr enclosing-list)))))))
